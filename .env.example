# Copy to .env and fill in. NEVER commit .env.
# Keys marked __ASK_USER__ are not available yet: ask the team lead (repo owner) when a task needs one.
# Code must run without them: LLM falls back to a template explainer, Jev falls back to Claude/rules.

# --- LLM (explanations, what-if parsing fallback) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=__ASK_USER__              # LLM provider key (format: OPENAI_API_KEY=sk-...)
ANTHROPIC_API_KEY=__ASK_USER__           # no longer used by P4 (kept for other parts)
LLM_MODEL=gpt-6-luna                 # P4 decision 11 Oct 2026: gpt-6-luna for every LLM call
LLM_MAX_TOKENS=1200
LLM_CACHE_DIR=cache/llm               # every request/response cached for replay

# --- Jev (TypeSafe System-1 model: routing, feasibility, explanation check) ---
JEV_ENABLED=false                     # set true only once a key exists
JEV_API_KEY=__ASK_USER__
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONFIDENCE_TAU=0.85               # recalibrated on our labelled set; see docs
JEV_CACHE_DIR=cache/jev

# --- Data access ---
EPC_API_TOKEN=__ASK_USER__            # GOV.UK One Login, get-energy-performance-data service
CEDA_USERNAME=__ASK_USER__            # HadUK-Grid / UKCP18 downloads (optional)
CEDA_PASSWORD=__ASK_USER__
MET_OFFICE_DATAHUB_KEY=__ASK_USER__   # optional live forecast panel
# Open-Meteo and PVGIS need no key (respect rate limits; responses cached in data/cache)

# --- Runtime ---
GREENTWIN_DATA_DIR=data
GREENTWIN_ARTIFACTS_DIR=artifacts
GREENTWIN_DB=data/greentwin.duckdb
GREENTWIN_DEVICE=cuda                 # GPU available; use cpu as fallback
GREENTWIN_SEED=42
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE=http://127.0.0.1:8000
