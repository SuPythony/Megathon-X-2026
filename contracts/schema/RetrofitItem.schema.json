    },
    "grants": {
      "items": {
        "type": "string"
      },
      "title": "Grants",
      "type": "array"
    },
    "sizing": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Continuous sizing bounds, e.g. {'kwp_min':1,'kwp_max':6}",
      "title": "Sizing"
    },
    "source": {
      "description": "Citation for cost/impact assumptions",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "twin_edits",
    "source"
