{
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "category": {
      "enum": [
        "fabric",
        "glazing",
        "heating",
        "renewables",
        "controls",
        "airtightness"
      ],
      "title": "Category",
      "type": "string"
    },
    "twin_edits": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "Parameter changes applied to the physics twin",
      "title": "Twin Edits",
      "type": "object"
    },
    "blocked_by_rules": {
      "description": "Rule ids that veto this retrofit",
      "items": {
        "type": "string"
      },
      "title": "Blocked By Rules",
      "type": "array"
    },
    "depends_on": {
      "description": "Should come after these (ordering)",
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    },
    "excludes": {
      "description": "Mutually exclusive retrofits",
      "items": {
        "type": "string"
      },
      "title": "Excludes",
      "type": "array"
    },
    "cost_gbp_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Gbp Low"
    },
    "cost_gbp_central": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Gbp Central"
    },
    "cost_gbp_high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Gbp High"
    },
    "cost_basis": {
      "default": "per_home",
      "description": "per_home | per_m2 | per_kwp | per_window",
      "title": "Cost Basis",
      "type": "string"
    },
    "cost_price_year": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Price Year"
    },
    "cost_status": {
      "default": "unsourced",
      "description": "unsourced -> no cost figure is ever shown (cost = null + reason)",
      "enum": [
        "sourced",
        "secondary_source",
        "unsourced"
      ],
      "title": "Cost Status",
      "type": "string"
    },
    "lifetime_years": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
