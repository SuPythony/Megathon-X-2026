{
  "$defs": {
    "AlternativeScore": {
      "description": "The same seven sub-scores combined with different weights (e.g. weights learned from data).\n\nReported beside the headline score, which always uses the brief's fixed weights.",
      "properties": {
        "name": {
          "const": "learned_weights",
          "default": "learned_weights",
          "title": "Name",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Component -> weight; sums to 1",
          "title": "Weights",
          "type": "object"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "band": {
          "enum": [
            "Highly efficient",
            "Good",
            "Moderate",
            "Poor",
            "Very poor"
          ],
          "title": "Band",
          "type": "string"
        },
        "score_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weights_version": {
          "description": "e.g. 'artifacts/score_weights/v1'",
          "title": "Weights Version",
          "type": "string"
        },
        "method": {
          "description": "How the weights were learned (documented in docs/score)",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "weights",
        "score",
        "band",
        "weights_version",
        "method"
      ],
      "title": "AlternativeScore",
      "type": "object"
    },
    "CalibrationDiagnostics": {
      "properties": {
        "max_r_hat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NUTS only; < 1.01 required",
          "title": "Max R Hat"
        },
        "min_ess": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Ess"
        },
        "elbo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SVI only",
          "title": "Elbo"
        },
        "divergences": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Divergences"
        },
        "posterior_predictive_coverage_90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of observed months in 90% PI",
          "title": "Posterior Predictive Coverage 90"
        }
      },
      "title": "CalibrationDiagnostics",
      "type": "object"
    },
    "CalibrationResult": {
      "description": "Bayesian calibration of one home's twin on its meter readings (summary; samples stored separately).",
      "properties": {
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "method": {
          "description": "prior_only when no meter data exists",
          "enum": [
            "nuts",
            "svi",
            "prior_only"
          ],
          "title": "Method",
          "type": "string"
        },
        "n_samples": {
          "title": "N Samples",
          "type": "integer"
        },
        "months_used": {
          "title": "Months Used",
          "type": "integer"
        },
        "months_imputed": {
          "description": "Missing months treated as latent",
          "items": {
            "type": "string"
          },
          "title": "Months Imputed",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/Distribution"
          },
          "description": "Posterior of the calibrated parameters: heat_loss_multiplier, setpoint_c, baseload, efficiency",
          "title": "Parameters",
          "type": "object"
        },
        "diagnostics": {
          "$ref": "#/$defs/CalibrationDiagnostics"
        },
        "data_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Data Confidence",
          "type": "string"
        },
        "posterior_ref": {
          "description": "Where the samples live, e.g. 'duckdb:posteriors/SH2/v3'",
          "title": "Posterior Ref",
          "type": "string"
        },
        "prior_source": {
          "default": "ebm_prior",
          "enum": [
            "ebm_prior",
            "rdsap_defaults",
            "hierarchy"
          ],
          "title": "Prior Source",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "property_id",
        "method",
        "n_samples",
        "months_used",
        "parameters",
        "data_confidence",
        "posterior_ref",
        "provenance"
      ],
      "title": "CalibrationResult",
      "type": "object"
    },
    "CredibleInterval": {
      "description": "Central (equal-tailed) credible interval, e.g. level 0.9 = P5..P95.",
      "properties": {
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        }
      },
      "required": [
        "level",
        "lo",
        "hi"
      ],
      "title": "CredibleInterval",
      "type": "object"
    },
    "Distribution": {
      "description": "Full posterior summary of an uncertain quantity (replaces the old mean/lo/hi Interval).\n\nBuilt from posterior samples by ``contracts.summarise.summarise``. A known-exact value\n(e.g. gas after a heat pump removes the boiler) is a degenerate distribution: std = 0.",
      "properties": {
        "unit": {
          "description": "e.g. 'kWh/yr', 'GBP/yr', 'kgCO2e/yr', 'points', '%'",
          "title": "Unit",
          "type": "string"
        },
        "n_samples": {
          "description": "Posterior samples the summary was computed from",
          "minimum": 1,
          "title": "N Samples",
          "type": "integer"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "median": {
          "description": "Equals percentiles.p50",
          "title": "Median",
          "type": "number"
        },
        "mode": {
          "description": "Most likely value: peak of the sample density (KDE)",
          "title": "Mode",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "skewness": {
          "default": 0.0,
          "description": "Sample skewness; |skew| > 0.5 -> headline uses the median",
          "title": "Skewness",
          "type": "number"
        },
        "percentiles": {
          "$ref": "#/$defs/Percentiles"
        },
        "credible_intervals": {
          "description": "At least the 50% and 90% intervals",
          "items": {
            "$ref": "#/$defs/CredibleInterval"
          },
          "title": "Credible Intervals",
          "type": "array"
        },
        "tail_probabilities": {
          "items": {
            "$ref": "#/$defs/TailProbability"
          },
          "title": "Tail Probabilities",
          "type": "array"
        },
        "worst_tail": {
          "default": "low",
          "description": "Which side is the bad outcome (low for savings, high for costs)",
          "enum": [
            "low",
            "high"
          ],
          "title": "Worst Tail",
          "type": "string"
        },
        "worst_5pct_mean": {
          "description": "Mean of the worst 5% of samples (expected shortfall)",
          "title": "Worst 5Pct Mean",
          "type": "number"
        },
        "histogram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headline": {
          "default": "mean",
          "description": "Which centre the UI/LLM shows first",
          "enum": [
            "mean",
            "median"
          ],
          "title": "Headline",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "n_samples",
        "mean",
        "median",
        "mode",
        "std",
        "percentiles",
        "credible_intervals",
        "worst_5pct_mean"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "ElectricityProfileSummary": {
      "description": "Half-hourly electricity layer summary (smart-meter load shapes + PV + battery + tariff).",
      "properties": {
        "self_consumption_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "peak_share_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of import in 16:00-19:00"
        },
        "bill_standard_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "bill_time_of_use_gbp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null until a ToU tariff is sourced"
        },
        "load_archetype_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Archetype Id"
        }
      },
      "required": [
        "bill_standard_gbp"
      ],
      "title": "ElectricityProfileSummary",
      "type": "object"
    },
    "ElementHeatLoss": {
      "description": "Level 1 heat loss per envelope element; drives 3D colouring.",
      "properties": {
        "element": {
          "enum": [
            "roof",
            "walls",
            "floor",
            "windows",
            "doors",
            "ventilation",
            "party_walls"
          ],
          "title": "Element",
          "type": "string"
        },
        "heat_loss_w_per_k": {
          "description": "Posterior mean",
          "title": "Heat Loss W Per K",
          "type": "number"
        },
        "heat_loss_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_pct": {
          "title": "Share Pct",
          "type": "number"
        },
        "u_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "U Value"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        },
        "estimated": {
          "default": true,
          "description": "Per-element split comes from priors, not measurement",
          "title": "Estimated",
          "type": "boolean"
        },
        "basis": {
          "default": "Estimated from home type and EPC descriptions; only the total heat loss is calibrated to bills",
          "description": "Label shown wherever element colours/values are displayed",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "element",
        "heat_loss_w_per_k",
        "share_pct"
      ],
      "title": "ElementHeatLoss",
      "type": "object"
    },
    "EnergyBreakdown": {
      "properties": {
        "electricity_import_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "gas_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "purchased_total_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "space_heating_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hot_water_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pv_generation_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intensity_kwh_m2": {
          "$ref": "#/$defs/Distribution",
          "description": "Annualised METERED energy (grid import + gas) / floor area, as defined in the brief; used by the score"
        },
        "intensity_weather_normalised_kwh_m2": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensitivity only; never used in the score"
        },
        "monthly": {
          "description": "Optional monthly series",
          "items": {
            "$ref": "#/$defs/MonthlyEnergy"
          },
          "title": "Monthly",
          "type": "array"
        }
      },
      "required": [
        "electricity_import_kwh",
        "gas_kwh",
        "purchased_total_kwh",
        "intensity_kwh_m2"
      ],
      "title": "EnergyBreakdown",
      "type": "object"
    },
    "Feasibility": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible",
            "feasible_with_conditions",
            "needs_survey",
            "infeasible"
          ],
          "title": "Status",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "rules",
            "jev",
            "llm_fallback",
            "agent"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reasons": {
          "description": "Human-readable, from rules/KB (never the LLM)",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "p_feasible": {
          "description": "1.0/0.0 for rules; recalibrated confidence for Jev",
          "maximum": 1,
          "minimum": 0,
          "title": "P Feasible",
          "type": "number"
        }
      },
      "required": [
        "retrofit_id",
        "status",
        "decided_by",
        "p_feasible"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "FeasibilityReport": {
      "properties": {
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Feasibility"
          },
          "title": "Items",
          "type": "array"
        },
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "jev_used": {
          "default": false,
          "title": "Jev Used",
          "type": "boolean"
        },
        "router": {
          "default": "rules_only",
          "enum": [
            "jev",
            "llm_fallback",
            "rules_only"
          ],
          "title": "Router",
          "type": "string"
        }
      },
      "required": [
        "property_id",
        "items",
        "rules_version"
      ],
      "title": "FeasibilityReport",
      "type": "object"
    },
    "FeatureContribution": {
      "description": "One additive term of a glass-box model (EBM shape function or hedonic coefficient x value).",
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The input value for this home",
          "title": "Value"
        },
        "contribution": {
          "description": "Additive contribution in the model's output unit",
          "title": "Contribution",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "feature",
        "contribution",
        "unit"
      ],
      "title": "FeatureContribution",
      "type": "object"
    },
    "Histogram": {
      "description": "Sample histogram for the UI density plot; len(bin_edges) == len(counts) + 1.",
      "properties": {
        "bin_edges": {
          "items": {
            "type": "number"
          },
          "title": "Bin Edges",
          "type": "array"
        },
        "counts": {
          "items": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "array"
        }
      },
      "required": [
        "bin_edges",
        "counts"
      ],
      "title": "Histogram",
      "type": "object"
    },
    "ImprovementPotential": {
      "description": "PS section 3: 100 x (E_base - E_after) / E_base on purchased energy, with ALL feasible retrofits run together.",
      "properties": {
        "pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the baseline is 0 or unavailable"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "electricity_change_kwh": {
          "$ref": "#/$defs/Distribution",
          "description": "baseline - after; negative = increase"
        },
        "gas_change_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "included_retrofits": {
          "description": "feasible + feasible_with_conditions",
          "items": {
            "type": "string"
          },
          "title": "Included Retrofits",
          "type": "array"
        },
        "excluded_needs_survey": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Needs Survey",
          "type": "array"
        },
        "pct_if_surveys_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "p_top_decile": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(home in top 10% by potential), for ranking",
          "title": "P Top Decile"
        }
      },
      "required": [
        "electricity_change_kwh",
        "gas_change_kwh"
      ],
      "title": "ImprovementPotential",
      "type": "object"
    },
    "KeyIssue": {
      "description": "PS section 3: why a home performs poorly, with the evidence behind it.",
      "properties": {
        "code": {
          "enum": [
            "high_intensity",
            "poor_insulation",
            "old_heating",
            "single_glazing",
            "no_renewables",
            "no_controls",
            "data_conflict",
            "missing_data"
          ],
          "title": "Code",
          "type": "string"
        },
        "label": {
          "description": "e.g. 'High energy use per m2 for a home like this'",
          "title": "Label",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "e.g. {'kwh_m2': 231, 'peer_p50': 165}",
          "title": "Evidence",
          "type": "object"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. P(intensity above peers)",
          "title": "Probability"
        }
      },
      "required": [
        "code",
        "label",
        "severity"
      ],
      "title": "KeyIssue",
      "type": "object"
    },
    "MonthlyEnergy": {
      "properties": {
        "month": {
          "description": "YYYY-MM",
          "title": "Month",
          "type": "string"
        },
        "electricity_import_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "gas_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "imputed": {
          "default": false,
          "description": "True when the meter reading was missing",
          "title": "Imputed",
          "type": "boolean"
        }
      },
      "required": [
        "month",
        "electricity_import_kwh",
        "gas_kwh"
      ],
      "title": "MonthlyEnergy",
      "type": "object"
    },
    "ParetoPoint": {
      "properties": {
        "package": {
          "items": {
            "type": "string"
          },
          "title": "Package",
          "type": "array"
        },
        "net_cost_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "carbon_saving_kgco2e": {
          "$ref": "#/$defs/Distribution"
        },
        "bill_saving_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "score_gain": {
          "$ref": "#/$defs/Distribution"
        },
        "p_on_front": {
          "title": "P On Front",
          "type": "number"
        },
        "is_knee": {
          "default": false,
          "title": "Is Knee",
          "type": "boolean"
        }
      },
      "required": [
        "package",
        "net_cost_gbp",
        "carbon_saving_kgco2e",
        "bill_saving_gbp",
        "score_gain",
        "p_on_front"
      ],
      "title": "ParetoPoint",
      "type": "object"
    },
    "Percentiles": {
      "description": "Posterior percentiles; must be non-decreasing from p1 to p99.",
      "properties": {
        "p1": {
          "title": "P1",
          "type": "number"
        },
        "p5": {
          "title": "P5",
          "type": "number"
        },
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p25": {
          "title": "P25",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
