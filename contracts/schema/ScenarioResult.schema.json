{
  "$defs": {
    "ElementHeatLoss": {
      "description": "Level 1 heat loss per envelope element; drives 3D colouring.",
      "properties": {
        "element": {
          "enum": [
            "roof",
            "walls",
            "floor",
            "windows",
            "doors",
            "ventilation",
            "party_walls"
          ],
          "title": "Element",
          "type": "string"
        },
        "heat_loss_w_per_k": {
          "title": "Heat Loss W Per K",
          "type": "number"
        },
        "share_pct": {
          "title": "Share Pct",
          "type": "number"
        },
        "u_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "U Value"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        }
      },
      "required": [
        "element",
        "heat_loss_w_per_k",
        "share_pct"
      ],
      "title": "ElementHeatLoss",
      "type": "object"
    },
    "EnergyBreakdown": {
      "properties": {
        "electricity_import_kwh": {
          "$ref": "#/$defs/Interval"
        },
        "gas_kwh": {
          "$ref": "#/$defs/Interval"
        },
        "purchased_total_kwh": {
          "$ref": "#/$defs/Interval"
        },
        "space_heating_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hot_water_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pv_generation_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intensity_kwh_m2": {
          "$ref": "#/$defs/Interval"
        }
      },
      "required": [
        "electricity_import_kwh",
        "gas_kwh",
        "purchased_total_kwh",
        "intensity_kwh_m2"
      ],
      "title": "EnergyBreakdown",
      "type": "object"
    },
    "Feasibility": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible",
            "feasible_with_conditions",
            "needs_survey",
            "infeasible"
          ],
          "title": "Status",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "rules",
            "jev",
            "claude_fallback",
            "agent"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "p_feasible": {
          "description": "1.0/0.0 for rules; recalibrated confidence for Jev",
          "maximum": 1,
          "minimum": 0,
          "title": "P Feasible",
          "type": "number"
        }
      },
      "required": [
        "retrofit_id",
        "status",
        "decided_by",
        "p_feasible"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "Interval": {
      "description": "Posterior summary of an uncertain quantity.",
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "lo": {
          "description": "Lower bound of the credible interval",
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "description": "Upper bound of the credible interval",
          "title": "Hi",
          "type": "number"
        },
        "level": {
          "default": 0.9,
          "description": "Credible level, e.g. 0.9 for 90%",
          "title": "Level",
          "type": "number"
        },
        "unit": {
          "description": "e.g. 'kWh/yr', 'GBP', 'kgCO2e/yr', 'points'",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "mean",
        "lo",
        "hi",
        "unit"
      ],
      "title": "Interval",
      "type": "object"
    },
    "ParetoPoint": {
      "properties": {
        "package": {
          "items": {
            "type": "string"
          },
          "title": "Package",
          "type": "array"
        },
        "net_cost_gbp": {
          "$ref": "#/$defs/Interval"
        },
        "carbon_saving_kgco2e": {
          "$ref": "#/$defs/Interval"
        },
        "bill_saving_gbp": {
          "$ref": "#/$defs/Interval"
        },
        "score_gain": {
          "$ref": "#/$defs/Interval"
        },
        "p_on_front": {
          "title": "P On Front",
          "type": "number"
        },
        "is_knee": {
          "default": false,
          "title": "Is Knee",
          "type": "boolean"
        }
      },
      "required": [
        "package",
        "net_cost_gbp",
        "carbon_saving_kgco2e",
        "bill_saving_gbp",
        "score_gain",
        "p_on_front"
      ],
      "title": "ParetoPoint",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a number came from. Every result carries one.",
      "properties": {
        "engine": {
          "enum": [
            "physics_l1",
            "surrogate_deeponet",
            "ebm",
            "xgboost",
            "hedonic",
            "dr_learner",
            "rules",
            "mock"
          ],
          "title": "Engine",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "data_version": {
          "title": "Data Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "n_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Posterior samples used",
          "title": "N Samples"
        }
      },
      "required": [
        "engine",
        "model_version",
        "data_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RetrofitEffect": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "order": {
          "description": "Position in the recommended sequence",
          "title": "Order",
          "type": "integer"
        },
        "feasibility": {
          "$ref": "#/$defs/Feasibility"
        },
        "electricity_saving_kwh": {
          "$ref": "#/$defs/Interval",
          "description": "Marginal, in sequence; negative = increase"
        },
        "gas_saving_kwh": {
          "$ref": "#/$defs/Interval"
        },
        "carbon_saving_kgco2e": {
          "$ref": "#/$defs/Interval"
        },
        "bill_saving_gbp": {
          "$ref": "#/$defs/Interval"
        },
        "cost_gbp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "p_net_benefit": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Net Benefit",
          "type": "number"
        },
        "p_suitable": {
          "description": "p_feasible * p_net_benefit",
          "maximum": 1,
          "minimum": 0,
          "title": "P Suitable",
          "type": "number"
        },
        "suitability": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "title": "Suitability",
          "type": "string"
        },
        "reason": {
          "description": "Short human-readable reason built from rule codes/KB, not LLM",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "retrofit_id",
        "order",
        "feasibility",
        "electricity_saving_kwh",
        "gas_saving_kwh",
        "carbon_saving_kgco2e",
        "bill_saving_gbp",
        "p_net_benefit",
        "p_suitable",
        "suitability",
        "reason"
      ],
      "title": "RetrofitEffect",
      "type": "object"
    },
    "ScoreComponent": {
      "properties": {
        "name": {
          "enum": [
            "energy_efficiency",
            "energy_intensity",
            "insulation",
            "heating_system",
            "windows_glazing",
            "renewable_energy",
            "smart_energy_management"
          ],
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "sub_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Sub Score",
          "type": "number"
        },
        "contribution": {
          "description": "weight * sub_score",
          "title": "Contribution",
          "type": "number"
        },
        "inputs_used": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Inputs Used",
          "type": "object"
        }
      },
      "required": [
        "name",
        "weight",
        "sub_score",
        "contribution"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "ScoreResult": {
      "properties": {
        "score": {
          "description": "Rounded weighted sum",
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "score_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "band": {
          "enum": [
            "Highly efficient",
            "Good",
            "Moderate",
            "Poor",
            "Very poor"
          ],
          "title": "Band",
          "type": "string"
        },
        "band_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Band Probabilities",
          "type": "object"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "key_issues": {
          "items": {
            "type": "string"
          },
          "title": "Key Issues",
          "type": "array"
        }
      },
      "required": [
        "score",
        "band",
        "components"
      ],
      "title": "ScoreResult",
      "type": "object"
    },
    "ValueImpact": {
      "properties": {
        "current_value_gbp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Value Gbp"
        },
        "uplift_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_after_gbp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "enum": [
            "hedonic_quantile",
            "dr_learner",
            "green_twin_matching",
            "unavailable"
          ],
          "title": "Method",
          "type": "string"
        },
        "label": {
          "const": "indicative",
          "default": "indicative",
          "title": "Label",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "current_value_gbp",
        "method"
      ],
      "title": "ValueImpact",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "property_id": {
      "title": "Property Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "baseline": {
      "$ref": "#/$defs/EnergyBreakdown"
    },
    "after": {
      "$ref": "#/$defs/EnergyBreakdown"
    },
    "electricity_saving_kwh": {
      "$ref": "#/$defs/Interval",
      "description": "baseline - after; negative = increase"
    },
    "gas_saving_kwh": {
      "$ref": "#/$defs/Interval"
    },
    "purchased_energy_saving_kwh": {
      "$ref": "#/$defs/Interval"
    },
    "improvement_potential_pct": {
      "anyOf": [
        {
          "$ref": "#/$defs/Interval"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "100*(E_base - E_after)/E_base on purchased energy; null if baseline 0/unavailable"
    },
    "improvement_potential_unavailable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Improvement Potential Unavailable Reason"
    },
    "carbon_saving_kgco2e": {
      "$ref": "#/$defs/Interval"
    },
    "emission_factors": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "kgCO2e/kWh used, e.g. {'electricity':0.177,'gas':0.183}",
      "title": "Emission Factors",
      "type": "object"
    },
    "emission_factor_source": {
      "title": "Emission Factor Source",
      "type": "string"
    },
    "bill_saving_gbp": {
      "$ref": "#/$defs/Interval"
    },
    "score_before": {
      "$ref": "#/$defs/ScoreResult"
    },
    "score_after": {
      "$ref": "#/$defs/ScoreResult"
    },
    "retrofits": {
      "items": {
        "$ref": "#/$defs/RetrofitEffect"
      },
      "title": "Retrofits",
      "type": "array"
    },
    "value": {
      "$ref": "#/$defs/ValueImpact"
    },
    "element_heat_loss_before": {
      "items": {
        "$ref": "#/$defs/ElementHeatLoss"
      },
      "title": "Element Heat Loss Before",
      "type": "array"
    },
    "element_heat_loss_after": {
      "items": {
        "$ref": "#/$defs/ElementHeatLoss"
      },
      "title": "Element Heat Loss After",
      "type": "array"
    },
    "pareto": {
      "items": {
        "$ref": "#/$defs/ParetoPoint"
      },
      "title": "Pareto",
      "type": "array"
    },
    "data_confidence": {
      "default": "medium",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Data Confidence",
      "type": "string"
    },
    "warnings": {
      "description": "Missing/conflicting data, OOD, assumptions",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "property_id",
    "provenance",
    "baseline",
    "after",
    "electricity_saving_kwh",
    "gas_saving_kwh",
    "purchased_energy_saving_kwh",
    "carbon_saving_kgco2e",
    "emission_factors",
    "emission_factor_source",
    "bill_saving_gbp",
    "score_before",
    "score_after",
    "value"
  ],
  "title": "ScenarioResult",
  "type": "object"
}