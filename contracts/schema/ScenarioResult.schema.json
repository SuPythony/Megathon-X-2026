{
  "$defs": {
    "CredibleInterval": {
      "description": "Central (equal-tailed) credible interval, e.g. level 0.9 = P5..P95.",
      "properties": {
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        }
      },
      "required": [
        "level",
        "lo",
        "hi"
      ],
      "title": "CredibleInterval",
      "type": "object"
    },
    "Distribution": {
      "description": "Full posterior summary of an uncertain quantity (replaces the old mean/lo/hi Interval).\n\nBuilt from posterior samples by ``contracts.summarise.summarise``. A known-exact value\n(e.g. gas after a heat pump removes the boiler) is a degenerate distribution: std = 0.",
      "properties": {
        "unit": {
          "description": "e.g. 'kWh/yr', 'GBP/yr', 'kgCO2e/yr', 'points', '%'",
          "title": "Unit",
          "type": "string"
        },
        "n_samples": {
          "description": "Posterior samples the summary was computed from",
          "minimum": 1,
          "title": "N Samples",
          "type": "integer"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "median": {
          "description": "Equals percentiles.p50",
          "title": "Median",
          "type": "number"
        },
        "mode": {
          "description": "Most likely value: peak of the sample density (KDE)",
          "title": "Mode",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "skewness": {
          "default": 0.0,
          "description": "Sample skewness; |skew| > 0.5 -> headline uses the median",
          "title": "Skewness",
          "type": "number"
        },
        "percentiles": {
          "$ref": "#/$defs/Percentiles"
        },
        "credible_intervals": {
          "description": "At least the 50% and 90% intervals",
          "items": {
            "$ref": "#/$defs/CredibleInterval"
          },
          "title": "Credible Intervals",
          "type": "array"
        },
        "tail_probabilities": {
          "items": {
            "$ref": "#/$defs/TailProbability"
          },
          "title": "Tail Probabilities",
          "type": "array"
        },
        "worst_tail": {
          "default": "low",
          "description": "Which side is the bad outcome (low for savings, high for costs)",
          "enum": [
            "low",
            "high"
          ],
          "title": "Worst Tail",
          "type": "string"
        },
        "worst_5pct_mean": {
          "description": "Mean of the worst 5% of samples (expected shortfall)",
          "title": "Worst 5Pct Mean",
          "type": "number"
        },
        "histogram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headline": {
          "default": "mean",
          "description": "Which centre the UI/LLM shows first",
          "enum": [
            "mean",
            "median"
          ],
          "title": "Headline",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "n_samples",
        "mean",
        "median",
        "mode",
        "std",
        "percentiles",
        "credible_intervals",
        "worst_5pct_mean"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "ElementHeatLoss": {
      "description": "Level 1 heat loss per envelope element; drives 3D colouring.",
      "properties": {
        "element": {
          "enum": [
            "roof",
            "walls",
            "floor",
            "windows",
            "doors",
            "ventilation",
            "party_walls"
          ],
          "title": "Element",
          "type": "string"
        },
        "heat_loss_w_per_k": {
          "title": "Heat Loss W Per K",
          "type": "number"
        },
        "share_pct": {
          "title": "Share Pct",
          "type": "number"
        },
        "u_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "U Value"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        },
        "estimated": {
          "default": true,
          "description": "Per-element split comes from priors, not measurement",
          "title": "Estimated",
          "type": "boolean"
        },
        "basis": {
          "default": "Estimated from home type and EPC descriptions; only the total heat loss is calibrated to bills",
          "description": "Label shown wherever element colours/values are displayed",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "element",
        "heat_loss_w_per_k",
        "share_pct"
      ],
      "title": "ElementHeatLoss",
      "type": "object"
    },
    "EnergyBreakdown": {
      "properties": {
        "electricity_import_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "gas_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "purchased_total_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "space_heating_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hot_water_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pv_generation_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intensity_kwh_m2": {
          "$ref": "#/$defs/Distribution",
          "description": "Annualised METERED energy (grid import + gas) / floor area, as defined in the brief; used by the score"
        },
        "intensity_weather_normalised_kwh_m2": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensitivity only; never used in the score"
        }
      },
      "required": [
        "electricity_import_kwh",
        "gas_kwh",
        "purchased_total_kwh",
        "intensity_kwh_m2"
      ],
      "title": "EnergyBreakdown",
      "type": "object"
    },
    "Feasibility": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible",
            "feasible_with_conditions",
            "needs_survey",
            "infeasible"
          ],
          "title": "Status",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "rules",
            "jev",
            "claude_fallback",
            "agent"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "p_feasible": {
          "description": "1.0/0.0 for rules; recalibrated confidence for Jev",
          "maximum": 1,
          "minimum": 0,
          "title": "P Feasible",
          "type": "number"
        }
      },
      "required": [
        "retrofit_id",
        "status",
        "decided_by",
        "p_feasible"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "Histogram": {
      "description": "Sample histogram for the UI density plot; len(bin_edges) == len(counts) + 1.",
      "properties": {
        "bin_edges": {
          "items": {
            "type": "number"
          },
          "title": "Bin Edges",
          "type": "array"
        },
        "counts": {
          "items": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "array"
        }
      },
      "required": [
        "bin_edges",
        "counts"
      ],
      "title": "Histogram",
      "type": "object"
    },
    "ParetoPoint": {
      "properties": {
        "package": {
          "items": {
            "type": "string"
          },
          "title": "Package",
          "type": "array"
        },
        "net_cost_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "carbon_saving_kgco2e": {
          "$ref": "#/$defs/Distribution"
        },
        "bill_saving_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "score_gain": {
          "$ref": "#/$defs/Distribution"
        },
        "p_on_front": {
          "title": "P On Front",
          "type": "number"
        },
        "is_knee": {
          "default": false,
          "title": "Is Knee",
          "type": "boolean"
        }
      },
      "required": [
        "package",
        "net_cost_gbp",
        "carbon_saving_kgco2e",
        "bill_saving_gbp",
        "score_gain",
        "p_on_front"
      ],
      "title": "ParetoPoint",
      "type": "object"
    },
    "Percentiles": {
      "description": "Posterior percentiles; must be non-decreasing from p1 to p99.",
      "properties": {
        "p1": {
          "title": "P1",
          "type": "number"
        },
        "p5": {
          "title": "P5",
          "type": "number"
        },
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p25": {
          "title": "P25",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p75": {
          "title": "P75",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        },
        "p95": {
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "p1",
        "p5",
        "p10",
        "p25",
        "p50",
        "p75",
        "p90",
        "p95",
        "p99"
      ],
      "title": "Percentiles",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a number came from. Every result carries one.",
      "properties": {
        "engine": {
          "enum": [
            "physics_l1",
            "surrogate_deeponet",
            "sap_estimator",
            "ebm",
            "xgboost",
            "hedonic",
            "dr_learner",
            "rules",
            "mock"
          ],
          "title": "Engine",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "data_version": {
          "title": "Data Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "n_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Posterior samples used",
          "title": "N Samples"
        }
      },
      "required": [
        "engine",
        "model_version",
        "data_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RatingEstimate": {
      "description": "Post-retrofit EPC-style rating from contracts/sap_estimator.json. Never presented as an EPC.",
      "properties": {
        "sap": {
          "$ref": "#/$defs/Distribution"
        },
        "band": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ],
          "title": "Band",
          "type": "string"
        },
        "band_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Band Probabilities",
          "type": "object"
        },
        "anchored_to_recorded_sap": {
          "description": "False when the home has no recorded EPC",
          "title": "Anchored To Recorded Sap",
          "type": "boolean"
        },
        "method": {
          "const": "sap2012_ecf_delta",
          "default": "sap2012_ecf_delta",
          "title": "Method",
          "type": "string"
        },
        "label": {
          "const": "estimated rating, not an EPC",
          "default": "estimated rating, not an EPC",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "sap",
        "band",
        "anchored_to_recorded_sap"
      ],
      "title": "RatingEstimate",
      "type": "object"
    },
    "RetrofitEffect": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "order": {
          "description": "Position in the recommended sequence",
          "title": "Order",
          "type": "integer"
        },
        "feasibility": {
          "$ref": "#/$defs/Feasibility"
        },
        "electricity_saving_kwh": {
          "$ref": "#/$defs/Distribution",
          "description": "Marginal, in sequence; negative = increase"
        },
        "gas_saving_kwh": {
          "$ref": "#/$defs/Distribution"
        },
        "carbon_saving_kgco2e": {
          "$ref": "#/$defs/Distribution"
        },
        "bill_saving_gbp": {
          "$ref": "#/$defs/Distribution"
        },
        "cost_gbp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cost_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the catalogue cost is unsourced",
          "title": "Cost Unavailable Reason"
        },
        "purchased_energy_saving_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Marginal grid import + gas saving"
        },
        "score_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Projected score after this step (cumulative)"
        },
        "improvement_potential_cumulative_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Improvement potential reached after steps 1..order"
        },
        "payback_years": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "p_net_benefit": {
          "description": "Under ScenarioSpec.goal, cost uncertainty included",
          "maximum": 1,
          "minimum": 0,
          "title": "P Net Benefit",
          "type": "number"
        },
        "p_suitable": {
          "description": "p_feasible * p_net_benefit",
          "maximum": 1,
          "minimum": 0,
          "title": "P Suitable",
          "type": "number"
        },
        "suitability": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "title": "Suitability",
          "type": "string"
        },
        "p_gain_above_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(step adds >= the documented gain threshold)",
          "title": "P Gain Above Threshold"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "recommended",
                "optional",
                "not_worth_adding",
                "needs_survey",
                "not_feasible"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "reason": {
          "description": "Short human-readable reason built from rule codes/KB, not LLM",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "retrofit_id",
        "order",
        "feasibility",
        "electricity_saving_kwh",
        "gas_saving_kwh",
        "carbon_saving_kgco2e",
        "bill_saving_gbp",
        "p_net_benefit",
        "p_suitable",
        "suitability",
        "reason"
      ],
      "title": "RetrofitEffect",
      "type": "object"
    },
    "ScoreComponent": {
      "properties": {
        "name": {
          "enum": [
            "energy_efficiency",
            "energy_intensity",
            "insulation",
            "heating_system",
            "windows_glazing",
            "renewable_energy",
            "smart_energy_management"
          ],
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "sub_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Sub Score",
          "type": "number"
        },
        "contribution": {
          "description": "weight * sub_score (posterior mean if the input is uncertain)",
          "title": "Contribution",
          "type": "number"
        },
        "contribution_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the component's input is uncertain (intensity, imputed fields)"
        },
        "inputs_used": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Inputs Used",
          "type": "object"
        }
      },
      "required": [
        "name",
        "weight",
        "sub_score",
        "contribution"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "ScoreResult": {
      "properties": {
        "score": {
          "description": "Rounded weighted sum (of the posterior mean inputs)",
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "score_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Score over posterior samples"
        },
        "band": {
          "description": "Mode of band_probabilities (most probable band)",
          "enum": [
            "Highly efficient",
            "Good",
            "Moderate",
            "Poor",
            "Very poor"
          ],
          "title": "Band",
          "type": "string"
        },
        "band_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "P(each band); sums to 1",
          "title": "Band Probabilities",
          "type": "object"
        },
        "p_poor_or_very_poor": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Poor Or Very Poor"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "key_issues": {
          "items": {
            "type": "string"
          },
          "title": "Key Issues",
          "type": "array"
        }
      },
      "required": [
        "score",
        "band",
        "components"
      ],
      "title": "ScoreResult",
      "type": "object"
    },
    "TailProbability": {
      "description": "Probability that the quantity falls beyond a meaningful threshold, e.g. P(saving < 0).",
      "properties": {
        "label": {
          "description": "Human-readable event, e.g. 'bill rises by more than \u00a3100/yr'",
          "title": "Label",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "direction": {
          "enum": [
            "below",
            "above"
          ],
          "title": "Direction",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "label",
        "threshold",
        "direction",
        "probability"
      ],
      "title": "TailProbability",
      "type": "object"
    },
    "ValueImpact": {
      "properties": {
        "current_value_gbp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Baseline valuation (never a historical sale price)",
          "title": "Current Value Gbp"
        },
        "current_value_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the current value is model-estimated rather than provided"
        },
        "band_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded EPC band",
          "title": "Band Before"
        },
        "band_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "From RatingEstimate (sap_estimator), not a lodged EPC",
          "title": "Band After"
        },
        "uplift_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_after_gbp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "enum": [
            "bayesian_hedonic",
            "hedonic_quantile",
            "dr_learner",
            "green_twin_matching",
            "unavailable"
          ],
          "title": "Method",
          "type": "string"
        },
        "label": {
          "const": "indicative",
          "default": "indicative",
          "title": "Label",
          "type": "string"
        },
        "wording": {
