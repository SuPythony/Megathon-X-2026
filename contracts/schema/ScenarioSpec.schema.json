{
  "$defs": {
    "RetrofitAction": {
      "properties": {
        "retrofit_id": {
          "title": "Retrofit Id",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. kWp, mm, kW",
          "title": "Size"
        },
        "stage_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Roadmap year (0 = now)",
          "title": "Stage Year"
        }
      },
      "required": [
        "retrofit_id"
      ],
      "title": "RetrofitAction",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "property_id": {
      "title": "Property Id",
      "type": "string"
    },
    "retrofits": {
      "description": "Empty = baseline only",
      "items": {
        "$ref": "#/$defs/RetrofitAction"
      },
      "title": "Retrofits",
      "type": "array"
    },
    "weather": {
      "default": "typical",
      "enum": [
        "typical",
        "cold_year",
        "warm_year",
        "forecast_week",
        "ukcp18_2050"
      ],
      "title": "Weather",
      "type": "string"
    },
    "n_samples": {
      "default": 500,
      "description": "Posterior samples to propagate",
      "title": "N Samples",
      "type": "integer"
    },
    "include_value": {
      "default": true,
      "title": "Include Value",
      "type": "boolean"
    },
    "include_pareto": {
      "default": false,
      "title": "Include Pareto",
      "type": "boolean"
    },
    "include_element_heat_loss": {
      "default": true,
      "title": "Include Element Heat Loss",
      "type": "boolean"
    },
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "goal": {
      "default": "bills",
      "description": "Defines 'net benefit' for suitability/verdicts; never changes computed numbers",
      "enum": [
        "bills",
        "carbon"
      ],
      "title": "Goal",
      "type": "string"
    },
    "requested_by": {
      "default": "ui",
      "enum": [
        "ui",
        "llm",
        "batch",
        "jev_router",
        "eval"
      ],
      "title": "Requested By",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "property_id"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}