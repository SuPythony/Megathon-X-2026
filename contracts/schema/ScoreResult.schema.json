{
  "$defs": {
    "AlternativeScore": {
      "description": "The same seven sub-scores combined with different weights (e.g. weights learned from data).\n\nReported beside the headline score, which always uses the brief's fixed weights.",
      "properties": {
        "name": {
          "const": "learned_weights",
          "default": "learned_weights",
          "title": "Name",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Component -> weight; sums to 1",
          "title": "Weights",
          "type": "object"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "band": {
          "enum": [
            "Highly efficient",
            "Good",
            "Moderate",
            "Poor",
            "Very poor"
          ],
          "title": "Band",
          "type": "string"
        },
        "score_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weights_version": {
          "description": "e.g. 'artifacts/score_weights/v1'",
          "title": "Weights Version",
          "type": "string"
        },
        "method": {
          "description": "How the weights were learned (documented in docs/score)",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "weights",
        "score",
        "band",
        "weights_version",
        "method"
      ],
      "title": "AlternativeScore",
      "type": "object"
    },
    "CredibleInterval": {
      "description": "Central (equal-tailed) credible interval, e.g. level 0.9 = P5..P95.",
      "properties": {
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        }
      },
      "required": [
        "level",
        "lo",
        "hi"
      ],
      "title": "CredibleInterval",
      "type": "object"
    },
    "Distribution": {
      "description": "Full posterior summary of an uncertain quantity (replaces the old mean/lo/hi Interval).\n\nBuilt from posterior samples by ``contracts.summarise.summarise``. A known-exact value\n(e.g. gas after a heat pump removes the boiler) is a degenerate distribution: std = 0.",
      "properties": {
        "unit": {
          "description": "e.g. 'kWh/yr', 'GBP/yr', 'kgCO2e/yr', 'points', '%'",
          "title": "Unit",
          "type": "string"
        },
        "n_samples": {
          "description": "Posterior samples the summary was computed from",
          "minimum": 1,
          "title": "N Samples",
          "type": "integer"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "median": {
          "description": "Equals percentiles.p50",
          "title": "Median",
          "type": "number"
        },
        "mode": {
          "description": "Most likely value: peak of the sample density (KDE)",
          "title": "Mode",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "skewness": {
          "default": 0.0,
          "description": "Sample skewness; |skew| > 0.5 -> headline uses the median",
          "title": "Skewness",
          "type": "number"
        },
        "percentiles": {
          "$ref": "#/$defs/Percentiles"
        },
        "credible_intervals": {
          "description": "At least the 50% and 90% intervals",
          "items": {
            "$ref": "#/$defs/CredibleInterval"
          },
          "title": "Credible Intervals",
          "type": "array"
        },
        "tail_probabilities": {
          "items": {
            "$ref": "#/$defs/TailProbability"
          },
          "title": "Tail Probabilities",
          "type": "array"
        },
        "worst_tail": {
          "default": "low",
          "description": "Which side is the bad outcome (low for savings, high for costs)",
          "enum": [
            "low",
            "high"
          ],
          "title": "Worst Tail",
          "type": "string"
        },
        "worst_5pct_mean": {
          "description": "Mean of the worst 5% of samples (expected shortfall)",
          "title": "Worst 5Pct Mean",
          "type": "number"
        },
        "histogram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headline": {
          "default": "mean",
          "description": "Which centre the UI/LLM shows first",
          "enum": [
            "mean",
            "median"
          ],
          "title": "Headline",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "n_samples",
        "mean",
        "median",
        "mode",
        "std",
        "percentiles",
        "credible_intervals",
        "worst_5pct_mean"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "Histogram": {
      "description": "Sample histogram for the UI density plot; len(bin_edges) == len(counts) + 1.",
      "properties": {
        "bin_edges": {
          "items": {
            "type": "number"
          },
          "title": "Bin Edges",
          "type": "array"
        },
        "counts": {
          "items": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "array"
        }
      },
      "required": [
        "bin_edges",
        "counts"
      ],
      "title": "Histogram",
      "type": "object"
    },
    "KeyIssue": {
      "description": "PS section 3: why a home performs poorly, with the evidence behind it.",
      "properties": {
        "code": {
          "enum": [
            "high_intensity",
            "poor_insulation",
            "old_heating",
            "single_glazing",
            "no_renewables",
            "no_controls",
            "data_conflict",
            "missing_data"
          ],
          "title": "Code",
          "type": "string"
        },
        "label": {
          "description": "e.g. 'High energy use per m2 for a home like this'",
          "title": "Label",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "e.g. {'kwh_m2': 231, 'peer_p50': 165}",
          "title": "Evidence",
          "type": "object"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. P(intensity above peers)",
          "title": "Probability"
        }
      },
      "required": [
        "code",
        "label",
        "severity"
      ],
      "title": "KeyIssue",
      "type": "object"
    },
    "Percentiles": {
      "description": "Posterior percentiles; must be non-decreasing from p1 to p99.",
      "properties": {
        "p1": {
          "title": "P1",
          "type": "number"
        },
        "p5": {
          "title": "P5",
          "type": "number"
        },
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p25": {
          "title": "P25",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p75": {
          "title": "P75",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        },
        "p95": {
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "p1",
        "p5",
        "p10",
        "p25",
        "p50",
        "p75",
        "p90",
        "p95",
        "p99"
      ],
      "title": "Percentiles",
      "type": "object"
    },
    "ScoreComponent": {
      "properties": {
        "name": {
          "enum": [
            "energy_efficiency",
            "energy_intensity",
            "insulation",
            "heating_system",
            "windows_glazing",
            "renewable_energy",
            "smart_energy_management"
          ],
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "sub_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Sub Score",
          "type": "number"
        },
        "contribution": {
          "description": "weight * sub_score (posterior mean if the input is uncertain)",
          "title": "Contribution",
          "type": "number"
        },
        "contribution_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the component's input is uncertain (intensity, imputed fields)"
        },
        "inputs_used": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Inputs Used",
          "type": "object"
        }
      },
      "required": [
        "name",
        "weight",
        "sub_score",
        "contribution"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "TailProbability": {
      "description": "Probability that the quantity falls beyond a meaningful threshold, e.g. P(saving < 0).",
      "properties": {
        "label": {
          "description": "Human-readable event, e.g. 'bill rises by more than \u00a3100/yr'",
          "title": "Label",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "direction": {
          "enum": [
            "below",
            "above"
          ],
          "title": "Direction",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "label",
        "threshold",
        "direction",
        "probability"
      ],
      "title": "TailProbability",
      "type": "object"
    }
  },
  "properties": {
    "score": {
      "description": "Rounded weighted sum (of the posterior mean inputs)",
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "score_distribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/Distribution"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Score over posterior samples"
    },
    "band": {
      "description": "Classification of the rounded score (brief section 2); band_probabilities gives the spread over posterior samples",
      "enum": [
        "Highly efficient",
        "Good",
        "Moderate",
        "Poor",
        "Very poor"
      ],
      "title": "Band",
      "type": "string"
    },
    "band_probabilities": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "P(each band); sums to 1",
      "title": "Band Probabilities",
      "type": "object"
    },
    "p_poor_or_very_poor": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P Poor Or Very Poor"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ScoreComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "key_issues": {
      "items": {
        "$ref": "#/$defs/KeyIssue"
      },
      "title": "Key Issues",
      "type": "array"
    },
    "projected": {
      "default": false,
      "description": "True for a post-retrofit score (uses RatingEstimate)",
      "title": "Projected",
      "type": "boolean"
    },
    "rating_source": {
      "default": "recorded_epc",
      "enum": [
        "recorded_epc",
        "estimated",
        "missing"
      ],
      "title": "Rating Source",
      "type": "string"
    },
    "peer_context": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "e.g. local-authority band shares from EPC live table D1",
      "title": "Peer Context",
      "type": "object"
    },
    "mapping_version": {
      "default": "score_mapping.json",
      "description": "Version of contracts/score_mapping.json used",
      "title": "Mapping Version",
      "type": "string"
    },
    "alternatives": {
      "description": "Companion scores with other weights (never replaces the headline score)",
      "items": {
        "$ref": "#/$defs/AlternativeScore"
      },
      "title": "Alternatives",
      "type": "array"
    }
  },
  "required": [
    "score",
    "band",
    "components"
  ],
  "title": "ScoreResult",
  "type": "object"
}