# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.uv-cache/
.uv-python/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.report_cache/
*.egg-info/

# Data (download with scripts; never commit raw or large files)
data/raw/
data/interim/
data/processed/*.parquet
data/processed/application_history.sqlite*
data/cache/
data/processed/synthetic/
*.duckdb
*.duckdb.wal

# Model artefacts (large); small JSON metadata/metrics may be committed
artifacts/**/*.pt
artifacts/**/*.pkl
artifacts/**/*.joblib
artifacts/**/*.nc
artifacts/**/*.safetensors
artifacts/**/*.parquet

# LLM / Jev response caches (keep locally for replay; commit only eval snapshots)
cache/llm/
cache/jev/

# Node / web
node_modules/
web/dist/
web/.vite/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Organiser brief and early drafts (not shared in repo)
LLOYDS-ps2.pdf
Green_Home_Ideas.pdf

# browser automation logs
.playwright-mcp/

# git worktrees (isolated per-task checkouts)
.worktrees/
artifacts/**/monitor.log
