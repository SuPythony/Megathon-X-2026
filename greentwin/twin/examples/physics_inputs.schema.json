        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Options",
          "type": "array"
        },
        "reason": {
          "description": "Why it is asked for this home",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "key",
