{
  "$defs": {
    "AppliancePlacement": {
      "description": "One appliance as the user entered it. Leave u/v empty to auto-place along the room's walls.",
      "properties": {
        "appliance_id": {
          "title": "Appliance Id",
          "type": "string"
        },
        "type": {
          "description": "Key in appliance_visuals.json",
          "title": "Type",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Archetype room key; None or 'outside' = outdoors",
          "title": "Room Id"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "u": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indoor: 0..1 across the room's width (x)",
          "title": "U"
        },
        "v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indoor: 0..1 across the room's depth (y)",
          "title": "V"
        },
        "x_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outdoor only: plan x in metres",
          "title": "X M"
        },
        "y_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outdoor only: plan y in metres (negative = in front)",
          "title": "Y M"
        },
        "rotation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Deg"
        },
        "answers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Size questions from appliance_energy.json, e.g. {'size': 'large'}",
          "title": "Answers",
          "type": "object"
        }
      },
      "required": [
        "appliance_id",
        "type"
      ],
      "title": "AppliancePlacement",
      "type": "object"
    },
    "BuiltForm": {
      "enum": [
        "detached",
        "semi_detached",
        "mid_terrace",
        "end_terrace",
        "enclosed_mid_terrace",
        "not_applicable"
      ],
      "title": "BuiltForm",
      "type": "string"
    },
    "GeometryConfirmation": {
      "properties": {
        "archetype_id": {
          "enum": [
            "victorian_terrace_2bed",
            "interwar_semi_3bed",
            "postwar_detached_4bed",
            "modern_terrace_3bed",
            "bungalow_2bed",
            "flat_2bed"
          ],
          "title": "Archetype Id",
          "type": "string"
        },
        "footprint_width_m": {
          "description": "Across the front",
          "exclusiveMaximum": 40,
          "exclusiveMinimum": 2,
          "title": "Footprint Width M",
          "type": "number"
        },
        "footprint_depth_m": {
          "description": "Front to back",
          "exclusiveMaximum": 40,
          "exclusiveMinimum": 2,
          "title": "Footprint Depth M",
          "type": "number"
        },
        "ceiling_height_m": {
          "default": 2.4,
          "maximum": 4.0,
          "minimum": 2.0,
          "title": "Ceiling Height M",
          "type": "number"
        },
        "front_azimuth_deg": {
          "default": 180.0,
          "description": "Way the front faces; 180 = south",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Front Azimuth Deg",
          "type": "number"
        },
        "built_form": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltForm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "room_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Room Labels",
          "type": "object"
        },
        "confirmed_by_user": {
          "default": false,
          "description": "True only after the user pressed confirm",
          "title": "Confirmed By User",
          "type": "boolean"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        }
      },
      "required": [
        "archetype_id",
        "footprint_width_m",
        "footprint_depth_m"
      ],
      "title": "GeometryConfirmation",
      "type": "object"
    },
    "MeterReading": {
      "description": "One month of bills or smart-meter data as the user entered it. Missing values stay None, never 0.",
      "properties": {
        "month": {
          "description": "YYYY-MM",
          "title": "Month",
          "type": "string"
        },
        "electricity_kwh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electricity Kwh"
        },
        "gas_kwh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 only if the home has no gas supply",
          "title": "Gas Kwh"
        },
        "estimated": {
          "default": false,
          "description": "Estimated read on the bill",
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "month"
      ],
      "title": "MeterReading",
      "type": "object"
    }
  },
  "description": "One home's intake. Images travel separately (multipart upload); only their file names are recorded here.",
  "properties": {
    "intake_id": {
      "title": "Intake Id",
      "type": "string"
    },
    "postcode_district": {
      "description": "Outward code only, e.g. 'M14'. Full postcodes are reduced on entry.",
      "title": "Postcode District",
      "type": "string"
    },
    "epc_rrn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "EPC certificate number, '0000-0000-0000-0000-0000'; None if unknown",
      "title": "Epc Rrn"
    },
    "floor_plan_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Floor Plan Image"
    },
    "fuse_box_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fuse Box Image"
    },
    "appliances": {
      "items": {
        "$ref": "#/$defs/AppliancePlacement"
      },
      "title": "Appliances",
      "type": "array"
    },
    "photo_consent": {
      "default": false,
      "description": "User agreed to interior photos being processed",
      "title": "Photo Consent",
      "type": "boolean"
    },
    "occupants": {
      "anyOf": [
        {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occupants"
    },
    "daytime_occupancy": {
      "anyOf": [
        {
          "enum": [
            "out_all_day",
            "part_day",
            "home_all_day"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Daytime Occupancy"
    },
    "thermostat_c": {
      "anyOf": [
        {
          "maximum": 28,
          "minimum": 10,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Thermostat setting",
      "title": "Thermostat C"
    },
    "heating_periods": {
      "description": "Heating on periods, e.g. [(6, 9), (17, 22)]",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Heating Periods",
      "type": "array"
    },
    "meter_readings": {
      "description": "Monthly bills, ideally 12+ months",
      "items": {
        "$ref": "#/$defs/MeterReading"
      },
      "title": "Meter Readings",
      "type": "array"
    },
    "heating_system": {
      "anyOf": [
        {
          "enum": [
            "gas_boiler_combi",
            "gas_boiler_regular",
            "oil_boiler",
            "lpg_boiler",
            "air_source_heat_pump",
            "ground_source_heat_pump",
            "electric_storage",
            "electric_storage_hhr",
            "electric_radiators",
            "district_or_communal",
            "solid_fuel"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heating System"
    },
    "hot_water_source": {
      "anyOf": [
        {
          "enum": [
            "from_boiler",
            "cylinder_from_boiler",
            "electric_immersion",
            "heat_pump_cylinder",
            "instantaneous_electric"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hot Water Source"
    },
    "internal_walls": {
      "anyOf": [
        {
          "enum": [
            "solid",
            "hollow"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Do internal walls sound solid or hollow when knocked? (thermal mass)",
      "title": "Internal Walls"
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeometryConfirmation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "House type and dimensions as the user confirmed or corrected them"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "intake_id",
    "postcode_district"
  ],
  "title": "TwinIntake",
  "type": "object"
}